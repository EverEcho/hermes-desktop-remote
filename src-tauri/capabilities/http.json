{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "gateway-http",
  "description": "Allows the bundled main window to connect to the user-configured Hermes Gateway.",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "http://*:*" },
        { "url": "https://*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
