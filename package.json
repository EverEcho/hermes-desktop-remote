{
  "name": "rhermes-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "RHermes mobile and web client for a remote Hermes Gateway.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "cap:sync": "npx cap sync",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:add:tauri": "npx cap add @capawesome/capacitor-tauri",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:tauri:sync": "npx cap sync @capawesome/capacitor-tauri",
    "cap:tauri": "npx cap run @capawesome/capacitor-tauri",
    "tauri:build": "npm run build && npm run cap:tauri:sync && tauri build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-tauri": "^0.0.1",
    "@nanostores/react": "^1.1.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@vscode/codicons": "^0.0.45",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "nanostores": "^1.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/http-proxy": "^1.17.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "http-proxy": "^1.18.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
